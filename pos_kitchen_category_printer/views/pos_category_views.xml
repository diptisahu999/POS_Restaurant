<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS Category Form View Inheritance -->
    <record id="pos_category_form_view_inherit_printer" model="ir.ui.view">
        <field name="name">pos.category.form.inherit.printer</field>
        <field name="model">pos.category</field>
        <field name="inherit_id" ref="point_of_sale.product_pos_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="printer_name" placeholder="e.g. TVS RP3200 Kitchen 1 / Bar / Tandoor"/>
                <field name="printer_url" placeholder="e.g. http://192.168.1.201:8069 or http://192.168.1.201:5000/print"/>
            </xpath>
        </field>
    </record>

    <!-- POS Category Tree/List View Inheritance -->
    <record id="pos_category_tree_view_inherit_printer" model="ir.ui.view">
        <field name="name">pos.category.tree.inherit.printer</field>
        <field name="model">pos.category</field>
        <field name="inherit_id" ref="point_of_sale.product_pos_category_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[last()]" position="after">
                <field name="printer_name" optional="show"/>
                <field name="printer_url" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
