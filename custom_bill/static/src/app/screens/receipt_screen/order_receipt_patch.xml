<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="custom_bill.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="replace">
            <div class="pos-receipt custom-thermal-bill">
                <!-- Header (Authentic Thermal Receipt Header) -->
                <div class="receipt-header text-center">
                    <div class="bill-brand-name fw-bold text-uppercase">LA FLORA CLUB</div>
                    <div class="bill-company-legal text-uppercase">BALAR INFRASTRUCTURE PRIVATE LIMITED</div>
                    <div class="bill-address">
                        VILLE FLORA, DAMAN-KUNTA ROAD,<br/>
                        VAPI, GUJARAT 396191
                    </div>
                    <div class="bill-mobile">Mo: +91 97379 82028</div>
                    <div class="bill-gstin">GSTIN: 24AAECB1503A1ZP</div>
                    <div class="bill-state">State: GUJARAT</div>

                    <div class="bill-doc-title text-uppercase">TAX INVOICE</div>
                    <div class="bill-doc-subtitle text-uppercase">ARICA</div>
                </div>

                <div class="bill-divider"/>

                <!-- Bill No & Date -->
                <div class="bill-meta-section">
                    <div>
                        <span class="fw-bold">Bill No: <t t-esc="billNumberFormatted"/></span>
                    </div>
                    <div>
                        <span>Bill Date: <t t-esc="billDateFormatted"/></span>
                    </div>
                </div>

                <div class="bill-divider"/>

                <!-- Table No, Steward, Cover (Matching Thermal Receipt Reference) -->
                <div t-if="hasTableInfo" class="table-steward-section">
                    <div class="d-flex justify-content-between fw-bold text-uppercase">
                        <span class="col-meta-table">Table No</span>
                        <span class="col-meta-steward text-center">Steward</span>
                        <span class="col-meta-cover text-end">Cover</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="col-meta-table fw-bold"><t t-esc="tableNumberFormatted"/></span>
                        <span class="col-meta-steward text-center text-uppercase"><t t-esc="stewardNameFormatted"/></span>
                        <span class="col-meta-cover text-end fw-bold"><t t-esc="guestsCount"/></span>
                    </div>
                </div>
                <div t-if="hasTableInfo" class="bill-divider"/>

                <!-- KOT Numbers (if available) -->
                <div t-if="kotNumbersFormatted" class="kot-section">
                    <span>Kot : <t t-esc="kotNumbersFormatted"/></span>
                </div>
                <div t-if="kotNumbersFormatted" class="bill-divider"/>

                <!-- Items Table Header -->
                <div class="items-header d-flex justify-content-between fw-bold">
                    <span class="col-item-name">Item Name</span>
                    <span class="col-qty text-center">Qty</span>
                    <span class="col-rate text-end">Rate</span>
                    <span class="col-amount text-end">Amount</span>
                </div>

                <div class="bill-divider"/>

                <!-- Item Lines (SAC code and number completely removed) -->
                <div class="items-container">
                    <t t-foreach="receiptLines" t-as="line" t-key="line.uuid or line_index">
                        <div class="item-line">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="col-item-name text-uppercase fw-semibold"><t t-esc="line.product_name"/></span>
                                <span class="col-qty text-center"><t t-esc="line.qty"/></span>
                                <span class="col-rate text-end font-monospace"><t t-esc="formatAmount(line.unit_price)"/></span>
                                <span class="col-amount text-end font-monospace"><t t-esc="formatAmount(line.price_subtotal)"/></span>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="bill-divider"/>

                <!-- Totals & 5% Tax -->
                <div class="totals-section">
                    <!-- Sub Total -->
                    <div class="d-flex justify-content-between total-row">
                        <span>Sub Total</span>
                        <span class="font-monospace" t-esc="formatAmount(subtotalAmount)"/>
                    </div>

                    <!-- Discount (Visible ONLY when discount is applied) -->
                    <div t-if="discountAmount > 0" class="d-flex justify-content-between total-row">
                        <span><t t-esc="discountLabelFormatted"/></span>
                        <span class="font-monospace"><t t-esc="formatAmount(discountAmount)"/></span>
                    </div>

                    <!-- Tax 5% -->
                    <div t-if="taxAmount > 0" class="d-flex justify-content-between total-row">
                        <span>Tax 5%</span>
                        <span class="font-monospace" t-esc="formatAmount(taxAmount)"/>
                    </div>

                    <!-- Round Off (if rounding applied) -->
                    <div t-if="roundingAmount !== 0" class="d-flex justify-content-between total-row">
                        <span>Round Off</span>
                        <span class="font-monospace" t-esc="formatAmount(roundingAmount)"/>
                    </div>

                    <!-- Bill Amount (Grand Total bordered with dashed lines) -->
                    <div class="bill-amount-row d-flex justify-content-between fw-bold">
                        <span>Bill Amount</span>
                        <span class="font-monospace" t-esc="formatAmount(payableAmount)"/>
                    </div>
                </div>

                <!-- Amount In Words -->
                <div class="amount-in-words-section">
                    <div>Amount In Words : <span class="fw-bold"><t t-esc="amountInWordsFormatted"/></span></div>
                </div>

                <div class="bill-divider"/>

                <!-- Footer: Cashier & Guest Signature -->
                <div class="bill-footer d-flex justify-content-between align-items-center">
                    <span>Cashier: <strong class="text-uppercase"><t t-esc="cashierNameFormatted"/></strong></span>
                    <span class="guest-sig-label">Guest Signature</span>
                </div>

                <!-- Hidden hook for any Odoo extension expecting before-footer -->
                <div class="before-footer d-none"/>
            </div>
        </xpath>
    </t>

</templates>
