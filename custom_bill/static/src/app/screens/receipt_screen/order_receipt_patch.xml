<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="custom_bill.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <!-- Dedicated Prominent Table Number Badge below Header -->
        <xpath expr="//ReceiptHeader" position="after">
            <div t-if="hasTableInfo" class="custom-bill-table-badge text-center my-2 p-2 rounded">
                <div class="table-badge-main">
                    <span class="table-badge-prefix">TABLE</span>
                    <span class="table-badge-number ms-1"><t t-esc="tableNumberFormatted"/></span>
                </div>
                <div class="table-badge-meta d-flex justify-content-center gap-3 mt-1">
                    <span t-if="floorNameFormatted" class="meta-item">
                        <i class="fa fa-map-marker me-1"/>Floor: <strong><t t-esc="floorNameFormatted"/></strong>
                    </span>
                    <span class="meta-item">
                        <i class="fa fa-users me-1"/>Guests: <strong><t t-esc="guestsCount"/></strong>
                    </span>
                </div>
            </div>
        </xpath>

        <!-- Dedicated Prominent Payable Amount Section -->
        <xpath expr="//div[hasclass('receipt-total')]" position="after">
            <div class="custom-bill-payable-section my-2 p-2 rounded">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="payable-title fw-bold text-uppercase">Payable Amount</span>
                    <span class="payable-amount font-monospace fw-bolder fs-4" t-out="payableAmountFormatted"/>
                </div>
                <div t-if="hasNcPayment and ncAmount > 0" class="nc-breakdown text-muted small d-flex justify-content-between mt-1">
                    <span>NC (No Charge) Applied:</span>
                    <span class="font-monospace text-danger">-<t t-out="ncAmountFormatted"/></span>
                </div>
            </div>
        </xpath>

        <!-- No Charge (NC) notice and reason on the bill -->
        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <t t-if="hasNcPayment">
                <div class="custom-bill-nc-notice text-start my-2 p-2 border border-danger rounded bg-light">
                    <div class="fw-bold text-danger small">
                        <i class="fa fa-exclamation-circle me-1"/>NO CHARGE (NC) APPLIED
                    </div>
                    <div t-if="ncReason" class="nc-reason-line small text-dark mt-1">
                        <strong>Reason:</strong> <t t-esc="ncReason"/>
                    </div>
                </div>
            </t>
        </xpath>
    </t>

</templates>
