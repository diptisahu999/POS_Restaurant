<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="custom_bill.PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('payment-name')]" position="after">
            <div t-if="line.nc_reason" class="text-danger small fst-italic ms-2">
                [NC Reason: <t t-esc="line.nc_reason"/>]
            </div>
        </xpath>
    </t>

</templates>
