<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_price_approval_tree" model="ir.ui.view">
            <field name="name">product.price.approval.list</field>
            <field name="model">product.price.approval</field>
            <field name="arch" type="xml">
                <list string="Price Approvals" create="0" decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                    <field name="name"/>
                    <field name="product_tmpl_id"/>
                    <field name="requester_id"/>
                    <field name="old_price"/>
                    <field name="new_price"/>
                    <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                    <field name="create_date" string="Requested On"/>
                </list>
            </field>
        </record>

        <record id="view_product_price_approval_form" model="ir.ui.view">
            <field name="name">product.price.approval.form</field>
            <field name="model">product.price.approval</field>
            <field name="arch" type="xml">
                <form string="Price Approval" create="0">
                    <header>
                        <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'pending'" groups="product_price_approval.group_price_approval_manager"/>
                        <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="state != 'pending'" groups="product_price_approval.group_price_approval_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="product_tmpl_id"/>
                                <field name="requester_id"/>
                            </group>
                            <group>
                                <field name="old_price"/>
                                <field name="new_price"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_product_price_approval_search" model="ir.ui.view">
            <field name="name">product.price.approval.search</field>
            <field name="model">product.price.approval</field>
            <field name="arch" type="xml">
                <search string="Price Approvals">
                    <field name="name"/>
                    <field name="product_tmpl_id"/>
                    <field name="requester_id"/>
                    <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                    <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                    <group>
                        <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                        <filter string="Product" name="group_product" domain="[]" context="{'group_by': 'product_tmpl_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_product_price_approval" model="ir.actions.act_window">
            <field name="name">Price Approvals</field>
            <field name="res_model">product.price.approval</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending': 1}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('product_price_approval.view_product_price_approval_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('product_price_approval.view_product_price_approval_form')})]"/>
        </record>

        <menuitem id="menu_product_price_approval_root"
                  name="Price Approvals"
                  action="action_product_price_approval"
                  web_icon="product_price_approval,static/description/icon.png"
                  sequence="100"/>
    </data>
</odoo>
