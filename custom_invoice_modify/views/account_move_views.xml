<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_restrict_draft" model="ir.ui.view">
        <field name="name">account.move.form.restrict.draft</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Restrict native Reset to Draft button to our custom group only -->
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="groups">custom_invoice_modify.group_modify_paid_invoices</attribute>
            </xpath>
        </field>
    </record>
</odoo>
