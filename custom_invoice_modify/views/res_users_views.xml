<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_custom_access" model="ir.ui.view">
        <field name="name">res.users.form.custom.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Inject CUSTOM ACCESS section after HUMAN RESOURCES on Access Rights tab -->
            <xpath expr="//page[@name='access_rights']" position="inside">
                <separator string="Custom Access"/>
                <group name="custom_access_group">
                    <field name="allow_modify_invoices" string="Modify Paid Invoices" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
