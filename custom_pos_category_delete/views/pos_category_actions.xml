<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action for POS Category (appears in Actions menu on list and form) -->
    <record id="action_server_force_delete_pos_category" model="ir.actions.server">
        <field name="name">Force Delete</field>
        <field name="model_id" ref="point_of_sale.model_pos_category"/>
        <field name="binding_model_id" ref="point_of_sale.model_pos_category"/>
        <field name="binding_view_types">form,list</field>
        <field name="group_ids" eval="[(4, ref('custom_pos_category_delete.group_allow_force_delete_pos_category'))]"/>
        <field name="state">code</field>
        <field name="code">
action = records.action_force_delete()
        </field>
    </record>

    <!-- Force Delete button in pos.category form view header -->
    <record id="product_pos_category_form_view_inherit_force_delete" model="ir.ui.view">
        <field name="name">pos.category.form.inherit.force.delete</field>
        <field name="model">pos.category</field>
        <field name="inherit_id" ref="point_of_sale.product_pos_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_force_delete"
                            string="Force Delete"
                            type="object"
                            class="btn-danger"
                            groups="custom_pos_category_delete.group_allow_force_delete_pos_category"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
