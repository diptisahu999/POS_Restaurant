<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_kitchen_printers" model="ir.ui.view">
        <field name="name">product.template.form.inherit.kitchen.printers</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_categ_ids']" position="after">
                <field name="pos_printer_ids" widget="many2many_tags" placeholder="Select Kitchen Printers (e.g. Kitchen 1, Bar)..."/>
            </xpath>
        </field>
    </record>
</odoo>
