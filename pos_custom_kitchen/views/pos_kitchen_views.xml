<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_kitchen_kanban" model="ir.ui.view">
        <field name="name">pos.order.kitchen.kanban</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="kitchen_state" create="false" edit="false">
                <field name="name"/>
                <field name="pos_reference"/>
                <field name="table_id"/>
                <field name="kitchen_state"/>
                <field name="state"/>
                <field name="date_order"/>
                <field name="kitchen_order_lines_summary"/>
                <field name="reorder_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click mt-2">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title" style="font-size: 18px; font-weight: 700;">
                                        <field name="pos_reference"/>
                                    </strong>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge rounded-pill text-bg-warning" style="font-size: 15px; padding: 6px 12px; font-weight: 600;">
                                        <field name="table_id"/>
                                    </span>
                                    <span t-if="record.reorder_count.raw_value > 0"
                                          class="badge rounded-pill text-bg-danger"
                                          style="font-size: 14px; padding: 6px 12px; font-weight: 700; animation: pulse 1s infinite;">
                                        🔁 Reorder <t t-esc="record.reorder_count.raw_value"/>
                                    </span>
                                </div>
                            </div>
                            <div class="mt-1 text-muted mb-2" style="font-size: 13px;">
                                <i class="fa fa-clock-o me-1"/> <field name="date_order"/>
                            </div>
                            <!-- Order Lines & Food Remarks -->
                            <div class="mt-2 border-top pt-2">
                                <field name="kitchen_order_lines_summary" widget="html"/>
                            </div>
                            <div class="o_kanban_record_bottom mt-3">
                                <div class="oe_kanban_bottom_left">
                                    <button name="action_start_preparing" type="object" class="btn btn-primary btn-sm px-3 py-1" style="font-weight: 600; font-size: 14px;" invisible="kitchen_state != 'pending'">Start Cooking</button>
                                    <button name="action_ready_to_serve" type="object" class="btn btn-warning btn-sm px-3 py-1" style="font-weight: 600; font-size: 14px;" invisible="kitchen_state != 'preparing'">Mark as Ready</button>
                                    <button name="action_mark_done" type="object" class="btn btn-success btn-sm px-3 py-1" style="font-weight: 600; font-size: 14px;" invisible="kitchen_state != 'ready_to_serve'">Served</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Kanban Action -->
    <record id="action_pos_kitchen_display" model="ir.actions.act_window">
        <field name="name">Kitchen Display</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', 'not in', ['cancel']), ('kitchen_state', 'in', ['pending', 'preparing', 'ready_to_serve'])]</field>
        <field name="view_id" ref="view_pos_order_kitchen_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Great job! No pending orders right now.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_pos_kitchen_root" 
              name="Kitchen" 
              sequence="20" 
              web_icon="pos_custom_kitchen,static/description/icon.png"/>
    <menuitem id="menu_pos_kitchen_dashboard" 
              name="Kitchen Dashboard" 
              parent="menu_pos_kitchen_root" 
              action="action_pos_kitchen_display" 
              sequence="1"/>
</odoo>
