<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_kitchen.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ActionpadWidget" position="after">
            <button
                class="btn btn-lg lh-sm btn-danger w-100 p-3"
                style="margin-top: 5px; background-color: #dc3545; border-color: #dc3545;"
                t-on-click="() => this.customSendToKitchen()"
                t-if="!currentOrder?.isEmpty()">
                <span class="d-block text-white" style="font-size: 26px; font-weight: 900; letter-spacing: 1px;">🍳 Send to Kitchen</span>
            </button>
        </xpath>
    </t>
</templates>
