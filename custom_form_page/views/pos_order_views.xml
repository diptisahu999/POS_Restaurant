<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_inherit_custom_status" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.custom.status</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="order_status" widget="badge"
                    decoration-muted="order_status == 'pending'"
                    decoration-warning="order_status == 'preparing'"
                    decoration-success="order_status == 'done'"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_inherit_custom_status" model="ir.ui.view">
        <field name="name">pos.order.list.inherit.custom.status</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="order_status" widget="badge"
                    decoration-muted="order_status == 'pending'"
                    decoration-warning="order_status == 'preparing'"
                    decoration-success="order_status == 'done'"/>
            </xpath>
        </field>
    </record>
</odoo>
