<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_force_delete_orders_access" model="ir.ui.view">
        <field name="name">res.users.form.force.delete.orders.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <separator string="POS Orders Management Permissions"/>
                <group name="pos_orders_management_access">
                    <field name="has_force_delete_pos_orders_access"
                           string="Allow Force Delete POS Orders / Sessions / Payments / Customers"
                           widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
